# The published image (.github/workflows/release.yml, image job): the panel,
# Xray, mtg and geo files come from the release archive the build job made with
# scripts/still-release.sh, which pins and checks every input; this file
# downloads none of them. The runtime layout is the final stage of ../../Dockerfile.
# Build context: the repository root with the build job's files in dist/.
FROM alpine:3.24@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf
ARG TARGETARCH
ENV TZ=Asia/Tehran
WORKDIR /app

RUN apk add --no-cache --update \
  ca-certificates \
  tzdata \
  fail2ban \
  bash \
  curl \
  openssl \
  nftables

# A bind mount, so the archive itself never lands in an image layer.
RUN --mount=type=bind,source=dist,target=/dist \
  cd /dist \
  && sha256sum -c "still-ui-linux-${TARGETARCH}.tar.gz.sha256" \
  && tar -xzf "still-ui-linux-${TARGETARCH}.tar.gz" -C /tmp still-ui/x-ui still-ui/x-ui.sh still-ui/bin \
  && mv /tmp/still-ui/x-ui /tmp/still-ui/bin /app/ \
  && mv /tmp/still-ui/x-ui.sh /usr/bin/x-ui \
  && rm -rf /tmp/still-ui

COPY DockerEntrypoint.sh /app/
COPY internal/web/translation /app/internal/web/translation

# Configure fail2ban
RUN rm -f /etc/fail2ban/jail.d/alpine-ssh.conf \
  && cp /etc/fail2ban/jail.conf /etc/fail2ban/jail.local \
  && sed -i "s/^\[ssh\]$/&\nenabled = false/" /etc/fail2ban/jail.local \
  && sed -i "s/^\[sshd\]$/&\nenabled = false/" /etc/fail2ban/jail.local \
  && sed -i "s/#allowipv6 = auto/allowipv6 = auto/g" /etc/fail2ban/fail2ban.conf

RUN chmod +x \
  /app/DockerEntrypoint.sh \
  /app/x-ui \
  /usr/bin/x-ui

ENV XUI_IN_DOCKER="true"
ENV XUI_MAIN_FOLDER="/app"
ENV XUI_ENABLE_FAIL2BAN="true"
ENV XUI_DB_TYPE=""
ENV XUI_DB_DSN=""
EXPOSE 2053
VOLUME [ "/etc/x-ui" ]
CMD [ "./x-ui" ]
ENTRYPOINT [ "/app/DockerEntrypoint.sh" ]
