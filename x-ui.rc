#!/sbin/openrc-run

command="/usr/local/still-ui/x-ui"
command_background=true
pidfile="/run/x-ui.pid"
description="still-ui panel (based on 3x-ui)"
procname="x-ui"
depend() {
    need net
}
start_pre(){
    cd /usr/local/still-ui
}
reload() {
  ebegin "Reloading ${RC_SVCNAME}"
  kill -USR1 $(cat $pidfile)
  eend $?
}